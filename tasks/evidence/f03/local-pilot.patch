+import "server-only";
+import { headers } from "next/headers";
+import { localPilotEnabled } from "./waygrain-pilot-policy";
+import type { Category } from "../types/category";
+import type { User } from "../types/user";
+
+export async function pilotEnabled(): Promise<boolean> {
+  return localPilotEnabled((await headers()).get("host") ?? "");
+}
+
+// Synthetic, process-local fixture identities; no credentials or auth cookies.
+export const pilotAdmin: User = {
+  id: "00000000-0000-4000-8000-000000000001",
+  name: "Waygrain synthetic admin", email: "", isAdmin: true,
+};
+const memory = globalThis as typeof globalThis & { __waygrainPilotCategories?: Category[] };
+function categories(): Category[] {
+  return memory.__waygrainPilotCategories ??= [{
+    id: "00000000-0000-4000-8000-000000000002",
+    title: "waygrain baseline category", createdAt: "2026-10-07T00:00:00Z",
+  }];
+}
+export function pilotListCategories(): Category[] {
+  return categories().map((row) => ({ ...row }));
+}
+function fixtureTitle(title: string) {
+  if (title !== "waygrain pilot category") throw new Error("Unsupported pilot fixture title");
+}
+export function pilotCreateCategory(title: string): Category {
+  fixtureTitle(title);
+  if (categories().some((row) => row.title === title)) throw new Error("Category already exists");
+  const row = { id: crypto.randomUUID(), title, createdAt: new Date().toISOString() };
+  categories().push(row);
+  return { ...row };
+}
+export function pilotUpdateCategory(id: string, title: string): Category {
+  fixtureTitle(title);
+  const row = categories().find((row) => row.id === id);
+  if (!row) throw new Error("Category not found");
+  row.title = title;
+  return { ...row };
+}
+export function pilotDeleteCategories(ids: string[]) {
+  const before = categories().length;
+  memory.__waygrainPilotCategories = categories().filter((row) => !ids.includes(row.id));
+  if (before === categories().length) throw new Error("No categories matched the query");
+  return { message: "All categories have been deleted" };
+}
